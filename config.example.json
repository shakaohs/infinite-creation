{
  "debug": false,
  "server": {
    "port": 4600,
    "host": "127.0.0.1"
  },
  "db": {
    "provider": "sqlite",
    "sqlite": {
      "path": ""
    },
    "postgres": {
      "url": "",
      "host": "127.0.0.1",
      "port": 5432,
      "user": "postgres",
      "password": "",
      "database": "infinite_creation",
      "ssl": false
    }
  },
  "comfyui": {
    "provider": "native",
    "baseUrl": "http://127.0.0.1:8188",
    "apiKey": "",
    "tier": "standard"
  },
  "engines": [
    {
      "id": "eng-image-demo",
      "name": "外接出图 API（示例）",
      "kind": "image",
      "enabled": false,
      "tasks": ["t2i", "i2i"],
      "baseUrl": "https://api.example.com",
      "apiKey": "sk-xxx",
      "model": "your-image-model",
      "authHeader": "Authorization",
      "authPrefix": "Bearer ",
      "submitPath": "/v1/images/generations",
      "pollPath": "/v1/images/generations/{taskId}",
      "requestTemplate": "{\"model\":\"{model}\",\"prompt\":\"{prompt}\",\"negative_prompt\":\"{negative_prompt}\",\"aspect_ratio\":\"{aspect_ratio}\",\"resolution\":\"{resolution}\",\"image\":\"{image}\"}",
      "taskIdPath": "data.taskId",
      "statusPath": "data.status",
      "doneValues": "succeeded,completed,done,success",
      "failValues": "failed,error,fail",
      "outputUrlPath": "data.output.url"
    },
    {
      "id": "eng-video-demo",
      "name": "Seedance 视频 API（示例）",
      "kind": "video",
      "enabled": false,
      "tasks": ["r2v", "i2v", "t2v"],
      "baseUrl": "https://api.example.com",
      "apiKey": "sk-xxx",
      "model": "seedance-2.5-pro",
      "authHeader": "Authorization",
      "authPrefix": "Bearer ",
      "submitPath": "/v1/videos/generations",
      "pollPath": "/v1/videos/generations/{taskId}",
      "requestTemplate": "{\"model\":\"{model}\",\"prompt\":\"{prompt}\",\"aspect_ratio\":\"{aspect_ratio}\",\"resolution\":\"{resolution}\",\"duration\":\"{duration}\",\"images\":[{images_json}]}",
      "taskIdPath": "data.taskId",
      "statusPath": "data.status",
      "doneValues": "succeeded,completed,done,success",
      "failValues": "failed,error,fail",
      "outputUrlPath": "data.output.url"
    }
  ],
  "hardware": {
    "mode": "nvidia"
  },
  "llm": {
    "baseUrl": "https://api.siliconflow.cn/v1",
    "apiKey": "sk-xxx",
    "model": "deepseek-ai/DeepSeek-V4.1-Flash",
    "tools": true,
    "vision": true
  },
  "generation": {
    "imageConcurrency": 2,
    "videoConcurrency": 1,
    "runninghubConcurrency": 1,
    "agentConcurrency": 4,
    "agentQueueTimeoutMinutes": 120,
    "videosPerShot": 1,
    "retryTimes": 3,
    "videoTimeoutMinutes": 30,
    "imageTimeoutMinutes": 10
  }
}
